NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
# Registration verification links use APP_ORIGIN + /verify-email?token=… — must match your deployed SPA URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_ACCESS_SECRET=change_me_access_secret_min_16_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Outbound email (optional). When all of MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASS, ADMIN_EMAIL are set,
# the server sends admin notifications (e.g. new order). Omit in local dev if you do not need SMTP.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=alhi7896542@gmail.com
MAIL_PASS=ujlhyvdgsnilcqsq
ADMIN_EMAIL=alhi7896542@gmail.com
# Optional. Defaults to MAIL_USER. Example: "Tiknova Orders" <orders@example.com>
MAIL_FROM=
# Optional. Defaults to true when MAIL_PORT is 465.
MAIL_SECURE=

# First admin (run once: npm run bootstrap:admin)
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_FULL_NAME=Platform Admin
